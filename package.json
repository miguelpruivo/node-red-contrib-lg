  "description": "Node-RED nodes to control and monitor LG ThinQ air conditioners and LG webOS TVs.",
  "keywords": [
    "node-red",
    "lg",
    "thinq",
    "webos",
    "air conditioner",
    "ac",
    "tv",
    "smart home",
    "home automation"
  ],
  "license": "MIT",
  "author": "Miguel Ruivo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelpruivo/node-red-contrib-lg.git"
  },
  "bugs": {
    "url": "https://github.com/miguelpruivo/node-red-contrib-lg/issues"
  },
  "homepage": "https://github.com/miguelpruivo/node-red-contrib-lg#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
