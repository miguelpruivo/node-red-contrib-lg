      "lg-tv": "nodes/lg-tv.js",
      "lg-tv-control": "nodes/lg-tv-control.js",
      "lg-tv-status": "nodes/lg-tv-status.js"
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lgtv2": "^1.6.3",
    "qs": "^6.12.0"
  }
