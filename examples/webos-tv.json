  {
    "id": "inj-tv-day",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Day look (08:00)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "00 08 * * *",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"brightness\":90,\"reduceBlueLight\":false}",
    "payloadType": "json",
    "x": 170,
    "y": 320,
    "wires": [
      [
        "tv-node"
      ]
    ]
  },
  {
    "id": "inj-tv-night",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Night look (21:00)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "00 21 * * *",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"brightness\":25,\"reduceBlueLight\":true}",
    "payloadType": "json",
    "x": 170,
    "y": 380,
    "wires": [
      [
        "tv-node"
      ]
    ]
  },
  {
    "id": "inj-tv-read",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Read picture settings",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"request\":\"ssap://settings/getSystemSettings\",\"params\":{\"category\":\"picture\",\"keys\":[\"backlight\",\"eyeComfortMode\",\"pictureMode\"]}}",
    "payloadType": "json",
    "x": 170,
    "y": 440,
    "wires": [
      [
        "tv-node"
      ]
    ]
  },
