[
  {
    "id": "flow-webos-example",
    "type": "tab",
    "label": "LG webOS TV example",
    "disabled": false,
    "info": "Example flow for controlling and monitoring an LG webOS TV with a single lg-tv node.\n\n1. Open the lg-tv node and enter the TV's IP and MAC address.\n2. On the TV, enable Settings -> General -> Mobile TV On so Wake-on-LAN works.\n3. Deploy. The first time, accept the pairing prompt on the TV screen.\n\nThe lg-tv node accepts on/off/toggle on its input and emits the TV power state on its output whenever it changes."
  },
  {
    "id": "inj-tv-on",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Turn ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "on",
    "payloadType": "str",
    "x": 150,
    "y": 120,
    "wires": [["tv-node"]]
  },
  {
