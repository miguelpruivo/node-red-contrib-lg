[
  {
    "id": "flow-webos-example",
    "type": "tab",
    "label": "LG webOS TV example",
    "disabled": false,
    "info": "Example flow for controlling and monitoring an LG webOS TV.\n\n1. Open the 'My LG TV' config node and enter the TV's IP and MAC address.\n2. On the TV, enable Settings -> General -> Mobile TV On so Wake-on-LAN works.\n3. Deploy. The first time, accept the pairing prompt on the TV screen."
  },
  {
    "id": "lg-tv-example",
    "type": "lg-tv",
    "name": "My LG TV",
    "host": "192.168.1.50",
    "mac": "AA:BB:CC:DD:EE:FF",
    "broadcast": "255.255.255.255",
    "secure": false
  },
  {
    "id": "inj-tv-on",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Turn ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "on",
    "payloadType": "str",
    "x": 150,
    "y": 100,
    "wires": [["tv-control"]]
  },
  {
    "id": "inj-tv-off",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Turn OFF",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "off",
    "payloadType": "str",
    "x": 150,
    "y": 160,
    "wires": [["tv-control"]]
  },
  {
    "id": "inj-tv-toggle",
    "type": "inject",
    "z": "flow-webos-example",
    "name": "Toggle",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "toggle",
    "payloadType": "str",
    "x": 150,
    "y": 220,
    "wires": [["tv-control"]]
  },
  {
    "id": "tv-control",
    "type": "lg-tv-control",
    "z": "flow-webos-example",
    "name": "",
    "tv": "lg-tv-example",
    "action": "msg",
    "x": 390,
    "y": 160,
    "wires": [["dbg-tv-result"]]
  },
  {
    "id": "dbg-tv-result",
    "type": "debug",
    "z": "flow-webos-example",
    "name": "TV control result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 620,
    "y": 160,
    "wires": []
  },
  {
    "id": "tv-status",
    "type": "lg-tv-status",
    "z": "flow-webos-example",
    "name": "",
    "tv": "lg-tv-example",
    "emitInitial": true,
    "x": 160,
    "y": 320,
    "wires": [["dbg-tv-status"]]
  },
  {
    "id": "dbg-tv-status",
    "type": "debug",
    "z": "flow-webos-example",
    "name": "TV on/off events",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 410,
    "y": 320,
    "wires": []
  }
]
