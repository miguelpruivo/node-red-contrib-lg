[
  {
    "id": "flow-thinq-example",
    "type": "tab",
    "label": "LG ThinQ AC example",
    "disabled": false,
    "info": "Example flow for controlling and monitoring an LG ThinQ air conditioner.\n\n1. Open the 'My LG account' config node and enter your LG credentials, then click 'Extract refresh token / Test'.\n2. Open the lg-ac and lg-ac-status nodes and pick your AC from the dropdown.\n3. Deploy."
  },
  {
    "id": "lg-account-example",
    "type": "lg-account",
    "name": "My LG account",
    "country": "US",
    "language": "en-US",
    "pollInterval": 60
  },
  {
    "id": "inj-ac-on",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Turn ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "on",
    "payloadType": "str",
    "x": 150,
    "y": 80,
    "wires": [["ac-control"]]
  },
  {
    "id": "inj-ac-off",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Turn OFF",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "off",
    "payloadType": "str",
    "x": 150,
    "y": 140,
    "wires": [["ac-control"]]
  },
  {
    "id": "inj-ac-cool",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Cool to 22C",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"power\":true,\"mode\":\"COOL\",\"temperature\":22,\"fan\":\"HIGH\"}",
    "payloadType": "json",
    "x": 150,
    "y": 200,
    "wires": [["ac-control"]]
  },
  {
    "id": "inj-ac-status",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Read status",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "status",
    "payloadType": "str",
    "x": 150,
    "y": 260,
    "wires": [["ac-control"]]
  },
  {
    "id": "ac-control",
    "type": "lg-ac",
    "z": "flow-thinq-example",
    "name": "Living room AC",
    "account": "lg-account-example",
    "deviceId": "",
    "x": 410,
    "y": 160,
    "wires": [["dbg-ac-result"]]
  },
  {
    "id": "dbg-ac-result",
    "type": "debug",
    "z": "flow-thinq-example",
    "name": "AC command result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 650,
    "y": 160,
    "wires": []
  },
  {
    "id": "ac-status",
    "type": "lg-ac-status",
    "z": "flow-thinq-example",
    "name": "Living room AC status",
    "account": "lg-account-example",
    "deviceId": "",
    "emitPeriodic": true,
    "emitOnChange": true,
    "includeRaw": false,
    "x": 180,
    "y": 380,
    "wires": [["dbg-ac-status"]]
  },
  {
    "id": "dbg-ac-status",
    "type": "debug",
    "z": "flow-thinq-example",
    "name": "AC status updates",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 470,
    "y": 380,
    "wires": []
  }
]
