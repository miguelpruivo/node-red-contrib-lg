[
  {
    "id": "flow-thinq-example",
    "type": "tab",
    "label": "LG ThinQ AC example",
    "disabled": false,
    "info": "Example flow for controlling and monitoring an LG ThinQ air conditioner with a single lg-ac node.\n\n1. Open the 'My LG account' config node and enter your LG credentials, then click 'Extract refresh token / Test'.\n2. Open the lg-ac node and pick your AC from the dropdown.\n3. Deploy.\n\nThe lg-ac node accepts commands on its input and emits the AC state on its output (after each command and on every poll cycle)."
  },
  {
    "id": "lg-account-example",
    "type": "lg-account",
    "name": "My LG account",
    "country": "US",
    "language": "en-US",
    "pollInterval": 60
  },
  {
    "id": "inj-ac-on",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Turn ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "on",
    "payloadType": "str",
    "x": 150,
    "y": 100,
    "wires": [["ac-node"]]
  },
  {
    "id": "inj-ac-off",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Turn OFF",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "off",
    "payloadType": "str",
    "x": 150,
    "y": 160,
    "wires": [["ac-node"]]
  },
  {
    "id": "inj-ac-cool",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Cool to 22C",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"power\":true,\"mode\":\"COOL\",\"temperature\":22,\"fan\":\"HIGH\"}",
    "payloadType": "json",
    "x": 150,
    "y": 220,
    "wires": [["ac-node"]]
  },
  {
    "id": "inj-ac-status",
    "type": "inject",
    "z": "flow-thinq-example",
    "name": "Read status",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "status",
    "payloadType": "str",
    "x": 150,
    "y": 280,
    "wires": [["ac-node"]]
  },
  {
    "id": "ac-node",
    "type": "lg-ac",
    "z": "flow-thinq-example",
    "name": "Living room AC",
    "account": "lg-account-example",
    "deviceId": "",
    "emitPeriodic": true,
    "emitOnChange": true,
    "includeRaw": false,
    "x": 410,
    "y": 190,
    "wires": [["dbg-ac"]]
  },
  {
    "id": "dbg-ac",
    "type": "debug",
    "z": "flow-thinq-example",
    "name": "AC state & results",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 650,
    "y": 190,
    "wires": []
  }
]
